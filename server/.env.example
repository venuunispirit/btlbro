# ===== Google Sheet Sync (server/.env) =====
# Copy this file to .env and fill in the values.

# --- Option A: Public sheet (no Google account needed) ---
# The backend reads the sheet via the public CSV export.
# The sheet must be shared as "Anyone with the link can view".
# Optional: overrides the URL connected in the Admin Panel.
GOOGLE_SHEET_ID="your-sheet-id-here"

# Worksheet (tab) to sync. If omitted, the ?gid= of the connected URL is used,
# otherwise the first tab (gid=0).
# Find the gid in the sheet URL: .../edit#gid=123456789
GOOGLE_SHEET_GID="0"

# --- Option B: Direct server writes (RECOMMENDED — no webhook / Apps Script) ---
# Create a service account in Google Cloud Console, enable the Sheets API,
# share the master sheet with the service-account e-mail as Editor, then
# either put the JSON key file path here OR paste the email + key directly.
GOOGLE_SERVICE_ACCOUNT_JSON="service-account.json"
# GOOGLE_CLIENT_EMAIL="sheets-bot@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Existing Google Drive OAuth (optional, only for Drive folder sync) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# --- Google Places Autocomplete (customer-facing search suggestions) ---
# Create a key in Google Cloud Console with the Places API enabled.
# The server proxies it — the browser never sees this key.
GOOGLE_MAPS_API_KEY=""

# --- Sheet BACKFILL (two-way sync: customer selections → Google Sheet) ---
# Preferred: configure GOOGLE_SERVICE_ACCOUNT_JSON above (direct server writes).
# Legacy fallback: deploy the Apps Script (server/apps-script/SheetBackfill.gs),
# deploy as Web App (Anyone), paste the /exec URL here. Until either is set,
# rows queue in db.json and can be exported as CSV from Admin → Drive tab.
SHEET_BACKFILL_WEBHOOK_URL=""
SHEET_BACKFILL_SECRET=""

# --- Products shop: customer payments (Razorpay) ---
# Create an account at razorpay.com → Dashboard → Settings → API Keys.
# Use TEST keys first (rzp_test_...). Without these keys checkout still works
# in "pay on confirmation" mode (order saved, team confirms payment manually).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- WhatsApp Business API (Meta Cloud API) ---
# One company token number — all team members chat through this number.
# Create at business.facebook.com → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="btlbro_verify"

# --- Telephony (Twilio) ---
# One inbound number = the company number. Calls route to the assigned exec's device.
# Create at twilio.com → Phone Numbers → Buy a number with Voice capability.
TWILIO_SID=""
TWILIO_TOKEN=""
TWILIO_FROM=""

# --- Admin API protection (REQUIRED in production) ---
# Frontend must send: Authorization: Bearer <ADMIN_PASSWORD>
NODE_ENV="development"
ADMIN_PASSWORD="change-me-in-production"

PORT=3001
